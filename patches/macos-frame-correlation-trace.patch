 namespace rex::graphics::vulkan {
 
 namespace {
+
+struct GrfsTraceSubmission {
+  uint64_t submission;
+  uint64_t frame;
+  perf::grfs_frame_trace::State state;
+};
+
+std::mutex grfs_trace_submissions_mutex;
+std::deque<GrfsTraceSubmission> grfs_trace_submissions;
+
+void GrfsTraceTrackSubmission(uint64_t submission, uint64_t frame,
+                              perf::grfs_frame_trace::State state) {
+  if (!frame || !perf::grfs_frame_trace::Enabled()) {
+    return;
+  }
+  perf::grfs_frame_trace::Record(
+      perf::grfs_frame_trace::Event::kGpuSubmit, frame, submission, 0, 0, state,
+      perf::grfs_frame_trace::kHasCorrelation);
+  std::lock_guard<std::mutex> lock(grfs_trace_submissions_mutex);
+  grfs_trace_submissions.push_back({submission, frame, state});
+}
 
+void GrfsTraceCompleteSubmissions(uint64_t completed_submission) {
+  std::vector<GrfsTraceSubmission> completed;
+  {
+    std::lock_guard<std::mutex> lock(grfs_trace_submissions_mutex);
+    while (!grfs_trace_submissions.empty() &&
+           grfs_trace_submissions.front().submission <= completed_submission) {
+      completed.push_back(grfs_trace_submissions.front());
+      grfs_trace_submissions.pop_front();
+    }
+  }
+  for (const GrfsTraceSubmission& submission : completed) {
+    perf::grfs_frame_trace::Record(
+        perf::grfs_frame_trace::Event::kGpuComplete, submission.frame,
+        submission.submission, 0, 0, submission.state,
+        perf::grfs_frame_trace::kHasCorrelation);
+  }
+}
