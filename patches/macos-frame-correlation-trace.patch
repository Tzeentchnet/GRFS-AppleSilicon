@@ -0,0 +1,128 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_MAC
+#include <dlfcn.h>
+#endif
+
+namespace rex::perf::grfs_frame_trace {
+
+enum class Event : uint32_t {
+  kIssueSwapBegin = 10,
+  kIssueSwapEnd = 11,
+  kGpuSubmit = 12,
+  kGpuComplete = 13,
+  kGuestOutputReady = 14,
+  kPresentEnqueue = 15,
+  kPipelineLookup = 20,
+  kPipelineCompile = 21,
+};
+
+enum class State : uint32_t {
+  kUnavailable = 0,
+  kSuccess = 1,
+  kFailure = 2,
+  kSkipped = 3,
+  kCacheHit = 4,
+  kCacheMiss = 5,
+  kDuplicate = 6,
+  kLegacy = 7,
+  kSuboptimal = 8,
+};
+
+enum Field : uint32_t {
+  kHasCorrelation = 1u << 0,
+  kHasDuration = 1u << 1,
+  kHasKey = 1u << 2,
+};
+
+using EnabledFunction = int (*)();
+using AcquireGuestFrameFunction = uint64_t (*)();
+using RecordFunction = void (*)(uint32_t, uint64_t, uint64_t, uint64_t, uint64_t,
+                                uint32_t, uint32_t);
+
+inline bool Enabled() {
+#if REX_PLATFORM_MAC
+  static auto function =
+      reinterpret_cast<EnabledFunction>(dlsym(RTLD_DEFAULT, "GRFSTraceEnabled"));
+  return function && function() != 0;
+#else
+  return false;
+#endif
+}
+
+inline uint64_t AcquireGuestFrame() {
+#if REX_PLATFORM_MAC
+  if (!Enabled()) {
+    return 0;
+  }
+  static auto function = reinterpret_cast<AcquireGuestFrameFunction>(
+      dlsym(RTLD_DEFAULT, "GRFSTraceAcquireGuestFrame"));
+  return function ? function() : 0;
+#else
+  return 0;
+#endif
+}
+
+inline void Record(Event event, uint64_t frame, uint64_t correlation,
+                   uint64_t duration, uint64_t key, State state, uint32_t fields) {
+#if REX_PLATFORM_MAC
+  if (!Enabled()) {
+    return;
+  }
+  static auto function =
+      reinterpret_cast<RecordFunction>(dlsym(RTLD_DEFAULT, "GRFSTraceRecordEvent"));
+  if (function) {
+    function(static_cast<uint32_t>(event), frame, correlation, duration, key,
+             static_cast<uint32_t>(state), fields);
+  }
+#endif
+}
+
+class ScopedDuration {
+ public:
+  ScopedDuration(Event event, uint64_t frame, uint64_t correlation = 0,
+                 uint64_t key = 0, uint32_t fields = 0)
+      : event_(event),
+        frame_(frame),
+        correlation_(correlation),
+        key_(key),
+        fields_(fields),
+        enabled_(Enabled()) {
+    if (enabled_) {
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+
+  ScopedDuration(const ScopedDuration&) = delete;
+  ScopedDuration& operator=(const ScopedDuration&) = delete;
+
+  ~ScopedDuration() {
+    if (!enabled_) {
+      return;
+    }
+    uint64_t duration = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now() - start_)
+                                     .count());
+    Record(event_, frame_, correlation_, duration, key_, state_,
+           fields_ | kHasDuration);
+  }
+
+  void SetState(State state) { state_ = state; }
+
+ private:
+  Event event_;
+  uint64_t frame_;
+  uint64_t correlation_;
+  uint64_t key_;
+  uint32_t fields_;
+  bool enabled_;
+  State state_ = State::kFailure;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace rex::perf::grfs_frame_trace
